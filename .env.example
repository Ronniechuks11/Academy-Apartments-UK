# Copy this file to .env and fill in real values before deploying.
# .env is already in .gitignore — never commit your real one.

SECRET_KEY=change-this-to-a-long-random-string
ADMIN_USERNAME=admin

# To set a real admin password, run this once in a Python shell:
#   from werkzeug.security import generate_password_hash
#   print(generate_password_hash("your-new-password"))
# then paste the output below.
ADMIN_PASSWORD_HASH=

# Leave as-is to keep using the local SQLite file.
DATABASE_URL=sqlite:///academy.db

# Set this to your real domain once you have one — used in the sitemap
# and in social share previews (Open Graph tags).
SITE_URL=https://your-domain-here.com

